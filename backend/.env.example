DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Production database (Render + external Postgres). Leave blank for local
# dev — settings.py falls back to SQLite when this is unset.
DATABASE_URL=

# AI provider keys — used starting Step 3 (ai.py). Leave blank until then.
GROQ_API_KEY=
# Optional — a second Groq account's key, tried once if the primary key
# is rate-limited. Leave blank to run with just GROQ_API_KEY.
GROQ_API_KEY_FALLBACK=
GEMINI_API_KEY=
OPENAI_API_KEY=
